limit_req_zone $binary_remote_addr zone=login_limit:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=reset_limit:10m rate=5r/m;

server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;
    client_max_body_size 25m;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MarySSL:10m;

    gzip on;
    gzip_min_length 256;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; frame-src 'self' blob:; object-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self';" always;

    location = /api/v1/login {
        limit_req zone=login_limit burst=10 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params.conf;
    }

    location = /api/v1/forgot-password {
        limit_req zone=reset_limit burst=3 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params.conf;
    }

    location = /api/v1/reset-password {
        limit_req zone=reset_limit burst=5 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params.conf;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params.conf;
    }

    location = /healthz {
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params.conf;
    }

    location / {
        proxy_pass http://frontend:8080;
        include /etc/nginx/proxy_params.conf;
    }
}
