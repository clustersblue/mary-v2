# Copy to .env for the Windows development stack.
# Do not commit .env. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=development
SECRET_KEY=replace-with-python-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application account for mary_api_db_new only. Create it for localhost,
# 127.0.0.1, and ::1. Docker Desktop on Windows connects as 127.0.0.1.
# Do not create this account as @% and do not use a production password here.
DATABASE_URL=mysql+aiomysql://mary_app:set-a-local-password@host.docker.internal:3306/mary_api_db_new
AUTO_CREATE_TABLES=true

# Use the same value in both variables. Keep it alphanumeric.
REDIS_PASSWORD=replace-with-a-long-random-string
REDIS_URL=redis://:replace-with-a-long-random-string@redis:6379/0
SESSION_MEMORY_FALLBACK=true

PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank until the mailbox password has been rotated. Reset mail is
# skipped when these are empty. The API still starts.
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional care-note generation. Leave blank to use the built-in fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=
