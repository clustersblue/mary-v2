# Copy to .env.production on the droplet. chmod 600 .env.production
# Start with:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

ENVIRONMENT=production
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DigitalOcean Managed MySQL in London. URL-encode reserved characters in the password.
# ssl_ca points at the certificate mounted by docker-compose.prod.yml.
DATABASE_URL=mysql+aiomysql://doadmin:URL_ENCODED_PASSWORD@db-mysql-lon1-xxxxx.b.db.ondigitalocean.com:25060/mary_api_db_new?ssl_ca=/etc/ssl/certs/do-mysql-ca.crt
AUTO_CREATE_TABLES=false

REDIS_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_URL=redis://:replace-with-openssl-rand-hex-32@redis:6379/0
SESSION_MEMORY_FALLBACK=false

DOMAIN=app.example.com
PUBLIC_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
ALLOWED_HOSTS=app.example.com

STORAGE_HOST_PATH=/var/mary/storage
MYSQL_CA_PATH=/var/mary/certs/ca-certificate.crt

SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=service@example.com
SMTP_PASSWORD=replace-with-the-rotated-mailbox-password
SMTP_FROM=service@example.com

GEMINI_API_KEY=
OPENAI_API_KEY=
