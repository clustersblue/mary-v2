# Copy to /var/mary/.env.production and run: chmod 600 .env.production
# Recreate the backend container after any change.
#
# Names this application reads are on the left.
# The requested blueprint names map as follows:
#   APP_ENV        -> ENVIRONMENT
#   APP_URL        -> PUBLIC_BASE_URL
#   FRONTEND_URL   -> CORS_ORIGINS (the page origin, one https URL)
#   SMTP_USERNAME  -> SMTP_USER
#   DB_*           -> DATABASE_URL (build it from database.env)

ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=mysql+aiomysql://mary_app:URL_ENCODED_PASSWORD@DB_HOST:25060/mary_api_db_new?ssl_ca=/etc/ssl/certs/do-mysql-ca.crt
AUTO_CREATE_TABLES=false

REDIS_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
REDIS_URL=redis://:REPLACE_WITH_THE_SAME_REDIS_PASSWORD@redis:6379/0
SESSION_MEMORY_FALLBACK=false

DOMAIN=registryv2.stmarysteamcare.co.uk
PUBLIC_BASE_URL=https://registryv2.stmarysteamcare.co.uk
CORS_ORIGINS=https://registryv2.stmarysteamcare.co.uk
ALLOWED_HOSTS=registryv2.stmarysteamcare.co.uk

STORAGE_HOST_PATH=/var/mary/storage
MYSQL_CA_PATH=/var/mary/certs/ca-certificate.crt

SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_MAILBOX_USERNAME
SMTP_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
SMTP_FROM=REPLACE_WITH_FROM_ADDRESS

GEMINI_API_KEY=
OPENAI_API_KEY=
