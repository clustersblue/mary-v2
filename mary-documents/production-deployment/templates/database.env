# Worksheet only. The API does not read DB_HOST or the other DB_* names.
# Build DATABASE_URL in backend.env from these values.
# URL-encode reserved characters in DB_PASSWORD before placing it in DATABASE_URL.

DB_HOST=db-mysql-lon1-REPLACE.b.db.ondigitalocean.com
DB_PORT=25060
DB_DATABASE=mary_api_db_new
DB_USERNAME=mary_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Resulting application setting:
# DATABASE_URL=mysql+aiomysql://DB_USERNAME:URL_ENCODED_DB_PASSWORD@DB_HOST:DB_PORT/DB_DATABASE?ssl_ca=/etc/ssl/certs/do-mysql-ca.crt
#
# Example shape, with the password already encoded:
# mysql+aiomysql://mary_app:encoded-password@db-mysql-lon1-xxxx.b.db.ondigitalocean.com:25060/mary_api_db_new?ssl_ca=/etc/ssl/certs/do-mysql-ca.crt
